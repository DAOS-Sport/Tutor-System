run = "cd server && npm install && PORT=3999 npm run dev"
modules = ["nodejs-20", "python-3.11", "postgresql-16"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["bash", "-c", "cd server && npm start"]
deploymentTarget = "autoscale"
build = ["bash", "-c", "cd server && npm install && cd ../client/admin && npm install && VITE_USE_MOCK=false npm run build && cd ../liff && npm install && VITE_USE_MOCK=false VITE_LIFF_ID_PARENT=\"$VITE_LIFF_ID_PARENT\" VITE_LIFF_ID_COACH=\"$VITE_LIFF_ID_COACH\" VITE_LIFF_ID=\"$LIFF_ID\" npm run build"]

[[ports]]
localPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001
exposeLocalhost = true

[[ports]]
localPort = 3998
externalPort = 3000

[[ports]]
localPort = 3999
externalPort = 80

[[ports]]
localPort = 5000

[[ports]]
localPort = 5001
externalPort = 3002

[[ports]]
localPort = 5099

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && PORT=3999 npm start"
waitForPort = 3999

[workflows.workflow.metadata]
outputType = "console"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
VITE_LIFF_ID_PARENT = "2009958451-NmGZ4135"
VITE_LIFF_ID_COACH = "2009958451-Xz4tru4a"
LIFF_URL_PARENT = "https://liff.line.me/2009958451-NmGZ4135"
LIFF_URL_COACH = "https://liff.line.me/2009958451-Xz4tru4a"
RAGIC_BASE_URL = "https://ap7.ragic.com"
ALLOW_DEMO_LOGIN = "1"
