run = "cd server && npm install && PORT=3999 npm run dev & node ../scripts/port-proxy.js"
modules = ["nodejs-20", "python-3.11", "postgresql-16"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["bash", "-c", "cd server && npm start"]
deploymentTarget = "autoscale"
# 部署 build 一律走唯一的 build 腳本（含版本戳記 + 清 stale assets + build-info.json），
# 消除先前「inline 指令 vs scripts/build-frontends.sh」兩套 build 漂移導致舊碼上線的風險。
# LIFF ID 由 [userenv.shared] 提供；SKIP_SMOKE=1 因部署階段還沒起 server。
build = ["bash", "-c", "SKIP_SMOKE=1 VITE_LIFF_ID=\"$LIFF_ID\" bash scripts/build-frontends.sh"]

[[ports]]
localPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 5000

[[ports]]
localPort = 3998
externalPort = 3000

[[ports]]
localPort = 3999
externalPort = 80

[[ports]]
localPort = 4321
externalPort = 4200

[[ports]]
localPort = 5000

[[ports]]
localPort = 5001
externalPort = 3002

[[ports]]
localPort = 5099

[[ports]]
localPort = 5190
externalPort = 3003

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && PORT=3999 npm start"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
VITE_LIFF_ID_PARENT = "2009958451-NmGZ4135"
VITE_LIFF_ID_COACH = "2009958451-Xz4tru4a"
LIFF_URL_PARENT = "https://liff.line.me/2009958451-NmGZ4135"
LIFF_URL_COACH = "https://liff.line.me/2009958451-Xz4tru4a"
RAGIC_BASE_URL = "https://ap7.ragic.com"
ALLOW_DEMO_LOGIN = "1"
