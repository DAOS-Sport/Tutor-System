run = "cd server && npm install && npm run dev"
modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["bash", "-c", "cd server && npm start"]
deploymentTarget = "autoscale"
build = ["bash", "-c", "cd server && npm install && cd ../client/admin && npm install && npm run build && cd ../liff && npm install && VITE_LIFF_ID=\"$LIFF_ID\" npm run build"]

[[ports]]
localPort = 3000
externalPort = 3000

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && npm start"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"
