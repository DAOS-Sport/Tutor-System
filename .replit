[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && PORT=3999 npm start & PROXY_PORT=3002 PROXY_TARGET_PORT=3999 node /home/runner/workspace/scripts/port-proxy.js"
waitForPort = 3999

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
VITE_LIFF_ID_PARENT = "2009958451-NmGZ4135"
VITE_LIFF_ID_COACH = "2009958451-Xz4tru4a"
LIFF_URL_PARENT = "https://liff.line.me/2009958451-NmGZ4135"
LIFF_URL_COACH = "https://liff.line.me/2009958451-Xz4tru4a"
RAGIC_BASE_URL = "https://ap7.ragic.com"
