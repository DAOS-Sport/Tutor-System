# ─────────────────────────────────────────────
# 資料庫（Replit PostgreSQL）
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/daos_db

# ─────────────────────────────────────────────
# JWT / Session
# ─────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_change_this
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# LINE Login（所有場館共用一個 Channel）
# ─────────────────────────────────────────────
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id
LINE_LOGIN_CHANNEL_SECRET=your_line_login_channel_secret
# 單一 LIFF（舊版 fallback）
LIFF_ID=your_liff_id
# 雙 LIFF（家長端 + 教練端，掛同一個 LINE Login Channel）
VITE_LIFF_ID_PARENT=your_parent_liff_id
VITE_LIFF_ID_COACH=your_coach_liff_id
# production 必要：強制要求 LINE id_token（教練 LINE-only / 家長 LINE-first）
# 設 1 後：教練 by-phone 不再首次綁定；家長 register / bind-phone 都需 id_token
REQUIRE_LINE_ID_TOKEN=1

# ─────────────────────────────────────────────
# 「問題回報」官方帳號（登入/註冊失敗時，按鈕會開啟對應 OA 並預填錯誤內容，使用者按送出即可）
# 填官方帳號 basic id（含 @，例：@400abcd）或完整連結（lin.ee / line.me）。
# 未設定時 fallback 走 LINE 一般分享讓使用者自選對象，按鈕仍可用。
# 註：須 VITE_ 前綴才會打包進前端。
# ─────────────────────────────────────────────
VITE_SUPPORT_LINE_COACH=@your_coach_oa_id    # 教練端回報 → 400 官方帳號
VITE_SUPPORT_LINE_PARENT=@your_parent_oa_id  # 家長端回報 → 家長官方帳號

# ─────────────────────────────────────────────
# LINE Messaging API（各場館獨立 Token，用 JSON 存多組）
# 格式：{"B":"token_for_venue_B","C":"token_for_venue_C"}
# ─────────────────────────────────────────────
LINE_MESSAGING_TOKENS={"B":"channel_access_token_venue_B","C":"channel_access_token_venue_C"}

# ─────────────────────────────────────────────
# Ragic API
# ─────────────────────────────────────────────
RAGIC_API_KEY=your_ragic_api_key
RAGIC_ACCOUNT=your_ragic_account_name
RAGIC_BASE_URL=https://www.ragic.com

# Ragic 表單路徑
RAGIC_FORM_H01=/your_account/hr/1      # H01-人事資料表
RAGIC_FORM_H05=/your_account/hr/5      # H05-參數-部門表
RAGIC_FORM_Z01=/your_account/student/1 # Z01-家長&學員關係管理
RAGIC_FORM_Z02=/your_account/student/2 # Z02-學員資料管理

# 家長 Ragic transactional outbox worker。安全預設為關閉；Production 僅能在
# schema 驗證與指定 Node canary 寫入/readback 成功後，透過部署 Secret 改為 true 並重啟。
RAGIC_PARENT_OUTBOX=false

# Ragic LINE UID 欄位 Field ID（可覆寫；預設值對應現行 Ragic schema）
# - Z01 家教系統uid（家長 LINE 登入綁定 UID 寫回欄位）
# - H01 個人LINE ID（教練 LINE UID 來源欄位）
RAGIC_FIELD_Z01_LINE_UID=1006846
RAGIC_FIELD_H01_LINE_UID=1003633

# ─────────────────────────────────────────────
# Replit Object Storage（媒體檔案）
# ─────────────────────────────────────────────
REPLIT_OBJECT_STORAGE_BUCKET=your_bucket_name
# production 未覆寫時一律選 Replit shared storage，並於 listen 前用 SDK list probe；
# local 開發維持 local。未填 bucket ID 時 SDK 使用 Replit sidecar 的 default bucket。
# 如需明確覆寫可設 local 或 replit；production 請使用 replit。
# OBJECT_STORAGE_DRIVER=replit
# 選填：使用非預設 bucket 時填 Replit bucket ID（優先於上方相容欄位）。
OBJECT_STORAGE_BUCKET_ID=

# ─────────────────────────────────────────────
# 應用程式設定
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# LIFF 推播用深連結 base：保留 liff.line.me 格式，讓 LINE 內點擊可自動登入（id_token）
# 正式網域：https://daos-tutoring-courses.replit.app/liff/（給 LINE Developers Console 設 LIFF Endpoint URL 用）
LIFF_URL=https://liff.line.me/your_liff_id
# 家長端 / 教練端 LIFF 深連結 base（cron / push 用；無結尾斜線、無 #）
LIFF_URL_PARENT=https://liff.line.me/your_parent_liff_id
LIFF_URL_COACH=https://liff.line.me/your_coach_liff_id
ADMIN_URL=https://daos-tutoring-courses.replit.app/admin

# ─────────────────────────────────────────────
# Ragic 受控驗證（server/scripts/ragic-auth-smoke.js）
# 預設只跑 read-only；要跑寫入須三項 env 同時設好
# ─────────────────────────────────────────────
# ENABLE_RAGIC_WRITE_SMOKE=1
# TEST_PHONE=0911000111
# TEST_PARENT_NAME=測試家長
# TEST_LINE_UID=U_test_only

# ─────────────────────────────────────────────
# Phase 8 效能 / 上線
# ─────────────────────────────────────────────
# Ragic in-process 快取 TTL（毫秒，預設 5 分鐘）。設 0 可關閉快取。
RAGIC_CACHE_TTL_MS=300000   # 設 0 或負值 → 完全停用快取（每次都打 Ragic）

# E2E / 效能腳本目標 base URL（tests/e2e、tests/perf 用）
BASE_URL=http://localhost:3000

# E2E 用的 admin 測試帳號（請改用 UAT 專用帳號，不要使用真實 admin）
ADMIN_USERNAME=manager
ADMIN_PASSWORD=manager
